# Copy this file to `.env` (never commit `.env`) and fill in YOUR project's values.
# Find them in Supabase Dashboard -> Project Settings -> API.
#
# These two are PUBLIC by design: they ship in the browser bundle, and security comes from
# Row Level Security and the Edge Function, not from hiding them.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key (or the newer "publishable" key, sb_publishable_...). NEVER the service_role / secret key.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ---------------------------------------------------------------------------------------------
# PRIVATE secrets do NOT belong in this file. The Edge Function gets them from Supabase itself:
#   supabase secrets set RATE_LIMIT_SALT=<long-random-string>
#   supabase secrets set ALLOWED_ORIGINS=https://your-site.example,http://localhost:5173
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically.)
# ---------------------------------------------------------------------------------------------
